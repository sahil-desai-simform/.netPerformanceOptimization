<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scoped to this repo so the samples restore from nuget.org alone.

    Without <clear/>, restore inherits every source from the machine-level NuGet.config. Any
    private/authenticated feed there will fail with NU1301 (401 Unauthorized) for a package it
    does not have, which blocks the build for reasons unrelated to this repo. Every package used
    here is public.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
